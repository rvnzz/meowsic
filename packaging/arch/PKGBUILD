# Maintainer: rvnzz <https://github.com/rvnzz>
# Неофициальный клиент Яндекс Музыки на GPUI.
pkgname=meowsic
pkgver=0.1.0
_tag=v${pkgver}
pkgrel=1
pkgdesc='Неофициальный десктоп-клиент Яндекс Музыки на GPUI (клон mashiro)'
arch=('x86_64')
url='https://github.com/rvnzz/meowsic'
license=('GPL3')
depends=('glibc' 'gcc-libs' 'alsa-lib' 'libxkbcommon' 'libx11' 'libxcb' 'wayland')
makedepends=('rust' 'git' 'pkgconf')
source=("git+${url}.git#tag=${_tag}")
sha256sums=('SKIP')

build() {
  cd meowsic
  cargo build --release --locked
}

check() {
  cd meowsic
  cargo test --release --locked
}

package() {
  cd meowsic
  install -Dm755 target/release/meowsic "${pkgdir}/usr/bin/meowsic"
  install -Dm644 packaging/linux/meowsic.desktop \
    "${pkgdir}/usr/share/applications/meowsic.desktop"
  install -Dm644 assets/icon.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/meowsic.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/meowsic/LICENSE"
}
